{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Octet",
  "version": "0.1.0",
  "identifier": "io.github.samchemman.octet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Octet",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": { "../src/vendor/opsin/NOTICES.txt": "licences/opsin.txt", "../data/nmr/LICENCE.txt": "licences/nmrshiftdb2.txt" },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["oct"],
        "name": "Octet Drawing",
        "description": "Octet drawing",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-octet-drawing",
        "exportedType": { "identifier": "io.github.samchemman.octet.drawing", "conformsTo": ["public.xml", "public.data"] },
        "contentTypes": ["io.github.samchemman.octet.drawing"]
      },
      {
        "ext": ["cdxml"],
        "name": "ChemDraw Drawing",
        "description": "ChemDraw drawing (CDXML)",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "chemical/x-cdxml"
      },
      {
        "ext": ["cdx"],
        "name": "ChemDraw Document",
        "description": "ChemDraw drawing (CDX)",
        "role": "Editor",
        "rank": "Default",
        "mimeType": "chemical/x-cdx"
      }
    ],
    "linux": {
      "deb": { "desktopTemplate": "linux/octet.desktop", "files": { "/usr/share/mime/packages/octet.xml": "linux/octet-mime.xml" } },
      "rpm": { "desktopTemplate": "linux/octet.desktop", "files": { "/usr/share/mime/packages/octet.xml": "linux/octet-mime.xml" } }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
