#!/bin/sh
# The AppImage's launcher (issue 37). The AppImage holds the WebKitGTK, GTK and libepoxy of the Ubuntu that built it.
# On other systems they can fail to use the graphics card, and then they draw with the processor, which is slow. So
# when the system has WebKitGTK 4.1, Octet uses the system's libraries, as the .deb and .rpm do. Else it uses the
# AppImage's copies, as AppImageKit's AppRun did.
#
# release.yml puts this file where Tauri gets the AppImage's AppRun from. linuxdeploy renames it AppRun.wrapped and
# starts it after Tauri's GTK hook (apprun-hooks/linuxdeploy-plugin-gtk.sh).
#
# OCTET_SYSTEM_LIBS: the folders to look in for the system's libraries. Set it empty to use the AppImage's copies.
set -f
a=$(dirname "$(readlink -f "$0")")
m=$(uname -m)
# The system's libraries: the first folder with WebKitGTK 4.1, and each folder after it that exists. A system that is
# not merged into /usr keeps GLib in /lib.
system=
for d in ${OCTET_SYSTEM_LIBS-/usr/lib/$m-linux-gnu /lib/$m-linux-gnu /usr/lib64 /lib64 /usr/lib /lib}; do
  if [ -e "$d/libwebkit2gtk-4.1.so.0" ] || { [ -n "$system" ] && [ -d "$d" ]; }; then system=${system:+$system:}$d; fi
done

# The session's LD_LIBRARY_PATH (empty when it has none), which src-tauri/src/linux.rs gives back to the programs that
# Octet starts.
export OCTET_SESSION_LD_LIBRARY_PATH="${LD_LIBRARY_PATH-}"
if [ -n "$system" ]; then
  # The loader looks in LD_LIBRARY_PATH before the RUNPATH that linuxdeploy gives Octet ($ORIGIN/../lib). So each
  # library comes from the system, and only a library that the system does not have comes from the AppImage.
  export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$system"
  # The system's GTK modules, schemas and theme, not the AppImage's that the GTK hook sets.
  unset GTK_DATA_PREFIX GTK_THEME GSETTINGS_SCHEMA_DIR GI_TYPELIB_PATH GIO_MODULE_DIR GTK_EXE_PREFIX GTK_PATH \
    GTK_IM_MODULE_FILE GDK_PIXBUF_MODULE_FILE
  XDG_DATA_DIRS=${XDG_DATA_DIRS#"$APPDIR/usr/share:/usr/share:"}
  [ -n "$XDG_DATA_DIRS" ] || unset XDG_DATA_DIRS
else
  # The library folders of AppImageKit's AppRun.
  l=
  for d in usr/lib usr/lib/i386-linux-gnu usr/lib/x86_64-linux-gnu usr/lib32 usr/lib64 lib lib/i386-linux-gnu \
    lib/x86_64-linux-gnu lib32 lib64; do l="$l$a/$d/:"; done
  export LD_LIBRARY_PATH="${l%:}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  export XDG_DATA_DIRS="$a/usr/share/:${XDG_DATA_DIRS:-/usr/local/share/:/usr/share/}"
  export GSETTINGS_SCHEMA_DIR="$a/usr/share/glib-2.0/schemas/${GSETTINGS_SCHEMA_DIR:+:$GSETTINGS_SCHEMA_DIR}"
  export GST_PLUGIN_SYSTEM_PATH="$a/usr/lib/gstreamer" GST_PLUGIN_SYSTEM_PATH_1_0="$a/usr/lib/gstreamer-1.0"
fi
export PATH="$a/usr/bin/:$PATH"
# The AppImage's WebKitGTK finds its processes from here: Tauri changes its /usr to ././.
cd "$a/usr" || exit 1
exec "$a/usr/bin/octet" "$@"
