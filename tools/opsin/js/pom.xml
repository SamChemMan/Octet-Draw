<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>octet</groupId><artifactId>opsin-js</artifactId><version>1</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <teavm.version>0.16.0</teavm.version>
    <teavm.target>JAVASCRIPT</teavm.target>
    <teavm.out>${project.build.directory}/js</teavm.out>
    <teavm.file>opsin.js</teavm.file>
    <teavm.minify>true</teavm.minify>
  </properties>
  <dependencies>
    <dependency><groupId>octet.patched</groupId><artifactId>opsin-core</artifactId><version>2.8.0-octet</version><exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
    <dependency><groupId>octet.patched</groupId><artifactId>automaton</artifactId><version>1.12-4-octet</version></dependency>
    <dependency><groupId>stax</groupId><artifactId>stax-api</artifactId><version>1.0.1</version></dependency>
    <dependency><groupId>org.teavm</groupId><artifactId>teavm-classlib</artifactId><version>${teavm.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.teavm</groupId><artifactId>teavm-jso</artifactId><version>${teavm.version}</version><scope>provided</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.teavm</groupId><artifactId>teavm-maven-plugin</artifactId><version>${teavm.version}</version>
        <executions><execution><id>tea</id><goals><goal>compile</goal></goals><phase>process-classes</phase>
          <configuration>
            <targetType>${teavm.target}</targetType>
            <mainClass>octet.OpsinJs</mainClass>
            <targetDirectory>${teavm.out}</targetDirectory>
            <targetFileName>${teavm.file}</targetFileName>
            <jsModuleType>ES2015</jsModuleType>
            <minifying>${teavm.minify}</minifying>
            <optimizationLevel>FULL</optimizationLevel>
            <stopOnErrors>true</stopOnErrors>
          </configuration>
        </execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
