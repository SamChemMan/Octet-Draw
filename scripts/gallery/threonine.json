   { "op": "arrow", "kind": "line", "from": "t4", "to": "s4", "start": "full", "end": "full" },
   { "op": "text", "text": "enantiomers", "above": "a9", "gap": 0.3 },
   { "op": "text", "text": "enantiomers", "above": "a10", "gap": 0.3 },
   { "op": "text", "text": "diastereomers", "right_of": "a11", "gap": 0.4, "align": "middle" },
   { "op": "text", "text": "diastereomers", "left_of": "a12", "gap": 0.4, "align": "middle" }
  ] } }
 ]
}
