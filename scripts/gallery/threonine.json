  { "name": "draw", "arguments": { "kind": "figure", "panels": [{ "rows": [
   [{ "structure": "(2S,3R)-2-amino-3-hydroxybutanoic acid", "number": "1", "caption": "L-threonine" },
    { "structure": "(2R,3S)-2-amino-3-hydroxybutanoic acid", "flip": "horizontal", "number": "2", "caption": "D-threonine" }],
   [{ "structure": "(2S,3S)-2-amino-3-hydroxybutanoic acid", "number": "3", "caption": [{ "text": "L-" }, { "text": "allo", "italic": true }, { "text": "-threonine" }] },
    { "structure": "(2R,3R)-2-amino-3-hydroxybutanoic acid", "flip": "horizontal", "number": "4", "caption": [{ "text": "D-" }, { "text": "allo", "italic": true }, { "text": "-threonine" }] }]
  ] }] } },
  { "name": "change", "arguments": { "operations": [
